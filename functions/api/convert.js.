const MAX_SOURCE_SIZE = 512 * 1024;
const MAX_NAME_ATTEMPTS = 10;

function randomName(length = 16) {
  const chars =
    "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";

  const bytes = new Uint8Array(length);
  crypto.getRandomValues(bytes);

  let result = "";

  for (let i = 0; i < bytes.length; i++) {
    result += chars[bytes[i] % chars.length];
  }

  return result;
}

function toBase64(text) {
  const bytes = new TextEncoder().encode(text);

  let binary = "";

  const chunkSize = 0x8000;

  for (let i = 0; i < bytes.length; i += chunkSize) {
    binary += String.fromCharCode(
      ...bytes.subarray(i, i + chunkSize)
    );
  }

  return btoa(binary);
}

async function githubRequest(url, token, options = {}) {
  return fetch(url, {
    ...options,

    headers: {
      "Authorization": `Bearer ${token}`,
      "Accept": "application/vnd.github+json",
      "X-GitHub-Api-Version": "2022-11-28",
      "Content-Type": "application/json",
      ...(options.headers || {})
    }
  });
}

async function fileExists({
  owner,
  repo,
  branch,
  filename,
  token
}) {
  const url =
    `https://api.github.com/repos/${encodeURIComponent(owner)}` +
    `/${encodeURIComponent(repo)}/contents/${filename}` +
    `?ref=${encodeURIComponent(branch)}`;

  const response = await githubRequest(
    url,
    token,
    {
      method: "GET"
    }
  );

  return response.status === 200;
}

async function generateAvailableFilename({
  owner,
  repo,
  branch,
  token
}) {
  for (
    let attempt = 0;
    attempt < MAX_NAME_ATTEMPTS;
    attempt++
  ) {
    const filename =
      `uploads/${randomName(20)}.lua`;

    const exists = await fileExists({
      owner,
      repo,
      branch,
      filename,
      token
    });

    if (!exists) {
      return filename;
    }
  }

  throw new Error(
    "Tidak berhasil mendapatkan nama file unik."
  );
}

export async function onRequestPost({
  request,
  env
}) {
  try {
    if (request.method !== "POST") {
      return Response.json(
        {
          ok: false,
          error: "Method tidak didukung."
        },
        {
          status: 405
        }
      );
    }

    const body = await request.json();

    const source =
      typeof body.source === "string"
        ? body.source
        : "";

    if (!source.trim()) {
      return Response.json(
        {
          ok: false,
          error: "Source kosong."
        },
        {
          status: 400
        }
      );
    }

    if (
      new TextEncoder().encode(source).length >
      MAX_SOURCE_SIZE
    ) {
      return Response.json(
        {
          ok: false,
          error: "Source terlalu besar."
        },
        {
          status: 413
        }
      );
    }

    const token = env.GITHUB_TOKEN;
    const owner = env.GITHUB_OWNER;
    const repo = env.GITHUB_REPO;
    const branch =
      env.GITHUB_BRANCH || "main";

    if (!token || !owner || !repo) {
      return Response.json(
        {
          ok: false,
          error:
            "GitHub belum dikonfigurasi di Cloudflare."
        },
        {
          status: 500
        }
      );
    }

    /*
     * Transformasi aman:
     * source tetap dipertahankan tanpa melakukan
     * obfuscation atau penyamaran perilaku kode.
     */
    const processedSource = source;

    const filename =
      await generateAvailableFilename({
        owner,
        repo,
        branch,
        token
      });

    const encoded =
      toBase64(processedSource);

    const uploadUrl =
      `https://api.github.com/repos/` +
      `${encodeURIComponent(owner)}/` +
      `${encodeURIComponent(repo)}/` +
      `contents/${filename}`;

    const uploadResponse =
      await githubRequest(
        uploadUrl,
        token,
        {
          method: "PUT",

          body: JSON.stringify({
            message:
              `Upload source ${filename}`,

            content: encoded,

            branch
          })
        }
      );

    const uploadData =
      await uploadResponse.json();

    if (!uploadResponse.ok) {
      return Response.json(
        {
          ok: false,
          error:
            uploadData.message ||
            "Upload GitHub gagal."
        },
        {
          status:
            uploadResponse.status
        }
      );
    }

    const rawUrl =
      `https://raw.githubusercontent.com/` +
      `${owner}/${repo}/` +
      `${encodeURIComponent(branch)}/` +
      `${filename}`;

    return Response.json({
      ok: true,
      filename,
      rawUrl,
      githubUrl:
        uploadData.content?.html_url || null
    });

  } catch (error) {
    return Response.json(
      {
        ok: false,
        error:
          error?.message ||
          "Terjadi kesalahan server."
      },
      {
        status: 500
      }
    );
  }
}
